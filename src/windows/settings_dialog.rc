#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "gui_resource.h"
#include "soundbridge_version.h"
#include "icon_path.h"
IDI_SOUNDBRIDGE ICON SOUNDBRIDGE_ICON_PATH
3 RT_MANIFEST "settings.manifest"

1 VERSIONINFO
FILEVERSION SOUNDBRIDGE_VERSION_NUMERIC
PRODUCTVERSION SOUNDBRIDGE_VERSION_NUMERIC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MaidTendouAris"
            VALUE "FileDescription", "TS3 SoundBridge audio sharing plugin"
            VALUE "FileVersion", SOUNDBRIDGE_VERSION_STRING
            VALUE "ProductName", "TS3 SoundBridge"
            VALUE "ProductVersion", SOUNDBRIDGE_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2026 MaidTendouAris. MIT License."
            VALUE "OriginalFilename", "ts3_soundbridge_win64.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 540, 332
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "TS3 SoundBridge · 设置"
FONT 9, "Microsoft YaHei UI", 400, 0, 1
BEGIN
    ICON IDI_SOUNDBRIDGE, IDC_LOGO, 12, 8, 20, 20
    LTEXT "选择要分享的声音", IDC_HEADER, 39, 11, 251, 17
    LTEXT "调整后点击“应用设置”", -1, 304, 12, 224, 14
    GROUPBOX "声音来源", -1, 12, 32, 284, 212
    CONTROL "共享所有非 TeamSpeak 的声音", IDC_MODE_ALL, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 24, 49, 260, 14
    CONTROL "只共享选定应用（可多选，包含子进程）", IDC_MODE_SELECTED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 24, 70, 260, 14
    CONTROL "", IDC_APPS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_TABSTOP | WS_BORDER, 24, 91, 260, 115
    LTEXT "播放声音后刷新列表。\n重启应用会自动关联。", -1, 24, 213, 130, 25
    PUSHBUTTON "清除选择", IDC_CLEAR, 161, 216, 56, 18
    PUSHBUTTON "刷新应用", IDC_REFRESH, 224, 216, 60, 18
    GROUPBOX "音量与电平（增益后）", -1, 304, 32, 224, 155
    LTEXT "共享声音", -1, 316, 49, 90, 14
    LTEXT "50%", IDC_DESKTOP_VALUE, 476, 49, 40, 14
    CONTROL "", IDC_DESKTOP_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 312, 66, 208, 20
    CONTROL "", IDC_DESKTOP_METER, "msctls_progress32", PBS_SMOOTH, 316, 92, 144, 8
    LTEXT "−∞ dBFS", IDC_DESKTOP_LEVEL, 466, 88, 50, 14
    LTEXT "麦克风", -1, 316, 110, 90, 14
    LTEXT "100%", IDC_MIC_VALUE, 476, 110, 40, 14
    CONTROL "", IDC_MIC_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 312, 127, 208, 20
    CONTROL "", IDC_MIC_METER, "msctls_progress32", PBS_SMOOTH, 316, 153, 144, 8
    LTEXT "−∞ dBFS", IDC_MIC_LEVEL, 466, 149, 50, 14
    LTEXT "共享时显示 · -60 → 0 dBFS · 红色：过载", -1, 316, 169, 200, 12
    CONTROL "麦克风独立静音（共享声音继续发送）", IDC_MIC_MUTE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 308, 195, 220, 15
    LTEXT "运行状态", -1, 12, 249, 110, 12
    CONTROL "显示运行详情", IDC_DETAILS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 185, 247, 111, 15
    LTEXT "共享已关闭。", IDC_STATUS, 12, 264, 284, 33
    GROUPBOX "版本与更新", IDC_UPDATE_GROUP, 304, 217, 224, 70
    CONTROL "每天自动检查", IDC_AUTO_UPDATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 316, 233, 100, 15
    PUSHBUTTON "检查更新", IDC_CHECK_UPDATE, 422, 231, 44, 18
    PUSHBUTTON "发布页", IDC_DOWNLOAD_UPDATE, 472, 231, 44, 18
    LTEXT "", IDC_UPDATE_STATUS, 316, 254, 200, 25
    DEFPUSHBUTTON "开始共享", IDC_START, 12, 302, 120, 20
    PUSHBUTTON "停止共享", IDC_STOP, 144, 302, 120, 20
    PUSHBUTTON "应用设置", IDC_APPLY, 276, 302, 120, 20
    PUSHBUTTON "关闭", IDCANCEL, 408, 302, 120, 20
END
